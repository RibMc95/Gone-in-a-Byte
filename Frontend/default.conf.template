server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Custom error pages
    error_page 404 /404.html;
    error_page 500 502 504 /50x.html;
    error_page 503 /maintenance.html;

    # Serve the error/maintenance pages. Exact-match locations are chosen over
    # "location /" during the internal error_page redirect, so the maintenance
    # gate below does not re-trigger on them (no redirect loop).
    location = /404.html { }
    location = /50x.html { }
    location = /maintenance.html { }

    # Cookie photos / fonts: safe to cache a while, since a changed image
    # normally ships under a new filename. These exact-asset locations sit
    # OUTSIDE the maintenance gate on purpose, so the maintenance page can
    # still load its own styling/images.
    location ~* \.(?:jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf)$ {
        expires 7d;
    }

    # CSS/JS carry the menu + prices and have no content-hash in their names,
    # so keep the cache short — repeat loads are fast but a price change shows
    # within minutes. nginx's ETag/Last-Modified still return 304s in between.
    location ~* \.(?:css|js)$ {
        expires 5m;
    }

    location / {
        # HTML always revalidates, so content edits and the maintenance toggle
        # below take effect immediately (no stale cached page).
        expires -1;

        # MAINTENANCE_MODE is substituted at container start (on | off).
        set $maintenance ${MAINTENANCE_MODE};
        if ($maintenance = "on") {
            return 503;
        }
        try_files $uri $uri/ =404;
    }
}

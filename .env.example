# Copy this file to .env for local development and fill in placeholder values in .env only.
# Keep .env.example free of active secrets.
# Required now for local sandbox checkout
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=
SQUARE_APPLICATION_ID=
SQUARE_APP_ID=
API_BASE_URL=
SQUARE_SDK_URL=
PORT=
SQUARE_LOCATION_ID=
# Optional later for OAuth/webhooks
SQUARE_CLIENT_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_CLIENT_SECRET=
SQUARE_OAUTH_REDIRECT_URI=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
# Dev-only: set to "true" to print full OAuth tokens to the server log during
# local testing. Leave blank/false in production (tokens are masked by default).
OAUTH_DEBUG_LOG_TOKENS=
# Auth — REQUIRED before launch. Use a strong random value (32+ bytes).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=10

# CORS allowlist — comma-separated origins allowed to call the API.
# Defaults to http://localhost:8080 if unset. Add your real domain for launch.
ALLOWED_ORIGINS=http://localhost:8080

# Admin allowlist — comma-separated emails allowed to run the kitchen queue
# (admin.html + /admin API: advance/cancel order fulfillment). Must match the
# email each admin logs in with. No default — leave blank to disable admin.
ADMIN_EMAILS=

# Optional currently unused integration
AFTERPAY_SCRIPT_URL=

# Oracle Autonomous Database (required for backend storage)
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_CONNECT_STRING=
# Local path (host machine) where wallet files are stored
ORACLE_WALLET_HOST_PATH=./oracle-wallet
# Container path defaults to /app/wallet via docker-compose
ORACLE_WALLET_DIR=/app/wallet
# Wallet password if your downloaded wallet requires one
ORACLE_WALLET_PASSWORD=
# Optional table names
ORACLE_ORDERS_TABLE=ORDERS
ORACLE_HISTORY_TABLE=ORDER_HISTORY
# How long (ms) an order may sit in "processing" before a new payment attempt
# can reclaim it (recovers orders stranded by a crash mid-charge). Default 300000 (5 min).
PAYMENT_PROCESSING_TIMEOUT_MS=
# How long (ms) a logged-in user's order list / history is cached in memory
# before it's re-read from the DB. Writes always bust the cache immediately, so
# this only bounds staleness as a backstop. Default 30000 (30 sec). In-memory,
# single backend instance only. Lower it toward 0 to effectively disable.
USER_CACHE_TTL_MS=
# Minimum hours between placing an order and its requested fulfillment time, so
# there's time to bake fresh. Same-day allowed by default (3). Default 3.
MIN_FULFILLMENT_LEAD_HOURS=
